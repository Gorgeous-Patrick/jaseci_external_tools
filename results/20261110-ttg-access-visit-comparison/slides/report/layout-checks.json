      "bottom": 0.6473333333333332,
      "top": 0.6739999999999999
    },
    {
      "page": 11,
      "text": "2  Resume after the last unresolved dependency",
      "left": 0.065,
      "right": 0.587265625,
      "bottom": 0.5277777777777778,
      "top": 0.56
    },
    {
      "page": 11,
      "text": "Insert a checkpoint after meal becomes known; preserve effects and native execution order.",
