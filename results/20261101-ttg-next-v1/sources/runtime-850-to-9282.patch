diff --git a/jac/tests/runtimelib/test_ttg_frontier_native.jac b/jac/tests/runtimelib/test_ttg_frontier_native.jac
new file mode 100644
index 000000000..ce4aab22b
--- /dev/null
+++ b/jac/tests/runtimelib/test_ttg_frontier_native.jac
@@ -0,0 +1,260 @@
+"""Persistent queued frontier integration beyond a homogeneous chain."""
+import from pathlib { Path }
+import json;
+import os;
+import from hashlib { sha256 }
+import from tempfile { mkdtemp }
+import from unittest.mock { patch }
+import from uuid { UUID }
+import from jaclang.runtime.context { ExecutionContext }
+import from jaclang.runtime.runtime { JacRuntime }
+import from jaclang.runtime.ttg_dependency_prefetch { dependency_prefetch }
+import from .fixtures.ttg_frontier_alias_walkers { FrontierAlias }
+import from .fixtures.ttg_frontier_walkers {
+    FrontierStart,
+    FrontierBranch,
+    FrontierLeaf,
+    FrontierDerivedLeaf,
+    FrontierQueue,
+    FrontierLeft,
+    FrontierRight,
+    FrontierWalk,
+    FrontierDuplicate,
+    FrontierCancel
+}
+
+
+def frontier_context(project: str) -> any {
+    ctx = ExecutionContext(
+        base_path_dir=project, full_target_path=str(Path(project, 'frontier.jac'))
+    );
+    JacRuntime.exec_ctx = ctx;
+    return ctx;
+}
+
+
+def frontier_seed -> tuple {
+    parent = Path('/tmp/ttg-next-native-v1/fixtures');
+    parent.mkdir(parents=True, exist_ok=True);
+    project = mkdtemp(prefix='case-', dir=str(parent));
+    ctx = frontier_context(project);
+    try {
+        start = FrontierStart();
+        root ++> start;
+        branches = [FrontierBranch(value=i) for i in range(4)];
+        for (index, branch) in enumerate(branches) {
+            start +>:FrontierQueue:+> branch;
+            branch +>:FrontierLeft:+> FrontierLeaf(value=index * 10 + 1);
+            leaf = FrontierDerivedLeaf(value=index * 10 + 2)
+                if index == 2
+                else FrontierLeaf(value=index * 10 + 2);
+            branch +>:FrontierRight:+> leaf;
+        }
+        return (project, start.__jac__.id, [b.__jac__.id for b in branches]);
+    } finally {
+        ctx.close();
+    }
+}
+
+
+def frontier_run(project: str, uid: UUID, wlk: any, enabled: bool) -> tuple {
+    ctx = frontier_context(project);
+    try {
+        origin = ctx.mem.get(uid).archetype;
+        store: any = ctx.mem.store;
+        original: any = store.rows;
+        calls: list = [];
+        def capture(sql: str, params: dict) -> list {
+            rows = original(sql, params);
+            calls.append(
+                {
+                    'sql': sql,
+                    'sha256': sha256(sql.encode()).hexdigest(),
+                    'params': params,
+                    'rows': len(rows)
+                }
+            );
+            return rows;
+        }
+        with patch.object(store, 'rows', side_effect=capture) {
+            with dependency_prefetch(
+                ctx, max_length=2048, mode='process', workers=1, fused_sql=enabled
+            ) as run {
+                origin spawn wlk;
+            }
+        }
+        summary = run.summary();
+        evidence = os.environ.get('TTG_NEXT_NATIVE_EVIDENCE');
+        if evidence {
+            with open(evidence, 'a') as output {
+                output.write(
+                    json.dumps(
+                        {
+                            'walker': type(wlk).__name__,
+                            'project': project,
+                            'origin': str(uid),
+                            'enabled': enabled,
+                            'reports': wlk.reports,
+                            'native_i': getattr(wlk, 'i', None),
+                            'native_entered': getattr(wlk, 'entered', None),
+                            'sql_calls': calls,
+                            'summary': summary
+                        },
+                        **{'default': str}
+                    )
+                        + '\n'
+                );
+            }
+        }
+        assert not run.errors , str(run.errors);
+        return (wlk.reports, summary);
+    } finally {
+        ctx.close();
+    }
+}
+
+test "A opaque reset prevents proof then B batches B C D E using sequential state" {
+    old = JacRuntime.exec_ctx;
+    try {
+        (project, uid, branches) = frontier_seed();
+        baseline = frontier_run(project, uid, FrontierWalk(), False);
+        compiled = frontier_run(project, uid, FrontierWalk(), True);
+        assert baseline[0] == [1, 12, 22, 32];
+        assert compiled[0] == baseline[0];
+        regions = [
+            r
+            for r in compiled[1]['fusion']['regions']
+            if r.get('compiled')
+        ];
+        assert any(len({d['origin'] for d in r['demands']}) == 4 for r in regions) , str(
+            regions
+        );
+        demands = next(
+            r['demands']
+            for r in regions
+            if len({d['origin'] for d in r['demands']}) == 4
+        );
+        assert [d['activation'] for d in demands] == [str(b) for b in branches];
+        assert demands[0]['event'] != demands[1]['event'];
+        assert demands[1]['event'] == demands[2]['event'] == demands[3]['event'];
+        assert compiled[1]['fusion']['template_queries'] >= 1;
+    } finally {
+        JacRuntime.exec_ctx = old;
+    }
+}
+
+test "Native duplicate visits and disengage outputs remain unchanged" {
+    old = JacRuntime.exec_ctx;
+    try {
+        (project, uid, branches) = frontier_seed();
+        for enabled in (False, True) {
+            alias = frontier_run(project, branches[0], FrontierAlias(), enabled);
+            assert alias[0] == [2] , str(alias);
+            if enabled {
+                assert alias[1]['fusion']['queries'] == 0;
+                assert 'alias' in alias[1]['fusion']['fallback_reason'];
+            }
+            duplicate = frontier_run(
+                project, branches[0], FrontierDuplicate(), enabled
+            );
+            assert duplicate[0] == [2, 2] , str(duplicate);
+            wlk = FrontierCancel();
+            cancelled = frontier_run(project, uid, wlk, enabled);
+            assert cancelled[0] == [] , str(cancelled);
+            assert wlk.entered == [0, 1] , str(wlk.entered);
+            if enabled {
+                assert cancelled[1]['fusion']['template_queries'] >= 1;
+                assert cancelled[1]['submitted_ids'];
+            }
+        }
+    } finally {
+        JacRuntime.exec_ctx = old;
+    }
+}
+
+test "Authenticated compiled full path cache cannot replace a shorter prefix" {
+    import from jaclang.runtime.archetype { Root, AccessLevel }
+    import from jaclang.runtime.graph_query { GraphQuery, QHop }
+    import from jaclang.runtime.graph_walk { access_gated }
+    import from jaclang.runtime.ttg_dependencies { TraceEvent }
+    import from jaclang.runtime.ttg_templates {
+        compile_templates,
+        hydrate_templates,
+        select_template,
+        publish_paths
+    }
+    import from jaclang.data.query_planner { resolve_query_prefix, resolve_ttg_path }
+    import jaclang.data.query_planner as planner;
+    old = JacRuntime.exec_ctx;
+    try {
+        parent = Path('/tmp/ttg-next-native-v1/fixtures');
+        parent.mkdir(parents=True, exist_ok=True);
+        project = mkdtemp(prefix='prefix-', dir=str(parent));
+        ctx = frontier_context(project);
+        try {
+            reader: any = Root().__jac__;
+            reader.persistent = True;
+            setattr(reader, 'root', reader.id);
+            ctx.mem.put(reader);
+            a = FrontierBranch(value=0);
+            b = FrontierBranch(value=1);
+            c = FrontierLeaf(value=2);
+            for arch in [a, b, c] {
+                anchor: any = arch.__jac__;
+                anchor.persistent = True;
+                setattr(anchor, 'root', reader.id);
+                anchor.own_access().all = AccessLevel.NO_ACCESS;
+                ctx.mem.put(anchor);
+            }
+            a +>:FrontierRight:+> b;
+            b +>:FrontierRight:+> c;
+            reader_id = reader.id;
+            ids = [a.__jac__.id, b.__jac__.id, c.__jac__.id];
+        } finally {
+            ctx.close();
+        }
+        ctx = frontier_context(project);
+        try {
+            ctx.set_user_root(str(reader_id));
+            assert access_gated();
+            origin: any = ctx.mem.get(ids[0]).archetype;
+            query = GraphQuery(
+                origin,
+                hops=[
+                    QHop(dir=2, `edge=FrontierRight, nd=FrontierBranch),
+                    QHop(dir=2, `edge=FrontierRight, nd=FrontierLeaf)
+                ]
+            ).`visit();
+            rows = resolve_ttg_path(ctx.mem, query, ids[0], 20);
+            assert rows is not None and [UUID(str(r[0])) for r in rows] == [ids[2]];
+            event = TraceEvent(
+                id=0,
+                kind='visit',
+                ability='branch',
+                line=0,
+                hop_chain=(
+                    ('FrontierRight', 'FrontierBranch', 2),
+                    ('FrontierRight', 'FrontierLeaf', 2)
+                )
+            );
+            bundle = hydrate_templates(compile_templates([event]));
+            assert publish_paths(
+                ctx.mem,
+                [(query, ids[0], rows, select_template(bundle, 'native', True, 0))]
+            );
+            store: any = ctx.mem.store;
+            with patch.object(store, 'rows', wraps=store.rows) as calls, patch.object(
+                planner, '_topology_node_ids', return_value=None
+            ) {
+                assert resolve_query_prefix(ctx.mem, query, 2) == [ids[2]];
+                assert calls.call_count == 0;
+                assert resolve_query_prefix(ctx.mem, query, 1) == [ids[1]];
+                assert calls.call_count == 1 , str(calls.call_args_list);
+            }
+        } finally {
+            ctx.close();
+        }
+    } finally {
+        JacRuntime.exec_ctx = old;
+    }
+}
diff --git a/jac/tests/runtimelib/test_ttg_templates.jac b/jac/tests/runtimelib/test_ttg_templates.jac
new file mode 100644
index 000000000..daedddc50
--- /dev/null
+++ b/jac/tests/runtimelib/test_ttg_templates.jac
@@ -0,0 +1,350 @@
+"""DB-free emitted SQL, bind contracts and sequential queued-state tests."""
+import json;
+import from unittest.mock { patch }
+import from uuid { UUID }
+import jaclang.sql as q;
+import from jaclang.runtime.ttg_templates {
+    compile_templates,
+    hydrate_templates,
+    bind_template,
+    select_template,
+    template_metrics
+}
+import from jaclang.runtime.ttg_dependencies {
+    analyze_walker_dependencies,
+    TraceEvent,
+    compile_checkpoint_plan,
+    checkpoint_graph
+}
+import from jaclang.runtime.ttg_frontier { collect_frontier }
+import from .fixtures.ttg_frontier_walkers {
+    FrontierWalk,
+    FrontierBranch,
+    FrontierDuplicate,
+    FrontierCancel
+}
+
+
+def entry_current(graph: any, ability: str, uid: str = 'b') -> tuple {
+    event = TraceEvent(
+        id=len(graph.events),
+        kind='entry',
+        ability=ability,
+        line=0,
+        next_id=graph.entries[ability]
+    );
+    graph.events.append(event);
+    current = {
+        'id': uid,
+        'node_type': FrontierBranch,
+        'facts': {'value': 0},
+        'transition_state': {'self.i': 0}
+    };
+    return (event, current);
+}
+
+test "Queued prefix evolves scalar state once in FIFO order" {
+    graph = analyze_walker_dependencies(FrontierWalk);
+    (event, current) = entry_current(graph, 'branch');
+    pending = [
+        {'id': 'c', 'node_type': FrontierBranch},
+        {'id': 'd', 'node_type': FrontierBranch}
+    ];
+    (prediction, demands) = collect_frontier(graph, current, event, pending, 20);
+    assert [a['id'] for (a, e) in demands] == ['b', 'c', 'd'] , str(prediction);
+    assert [e.hop_chain[0][0] for (a, e) in demands]
+        == ['FrontierLeft', 'FrontierRight', 'FrontierRight'];
+    assert [a['id'] for a in pending] == ['c', 'd'];
+    assert current['transition_state'] == {'self.i': 0};
+}
+
+test "Repeated path visits keep distinct site IDs and activations" {
+    graph = analyze_walker_dependencies(FrontierDuplicate);
+    (event, current) = entry_current(graph, 'branch');
+    (prediction, demands) = collect_frontier(
+        graph, current, event, [{'id': 'c', 'node_type': FrontierBranch}], 20
+    );
+    assert [a['id'] for (a, e) in demands] == ['b', 'b', 'c', 'c'];
+    assert demands[0][1].id != demands[1][1].id;
+    assert demands[0][1].hop_chain == demands[1][1].hop_chain;
+}
+
+test "Typed LIMIT binds zero or positive int and rejects bool negative and missing" {
+    relation = q.values([q.field('x', q.int64_type())], [[q.int64(1)]]);
+    compiled = q.compile_sql(
+        q.ordered(relation, [], limit=q.slot('cap', q.int64_type()))
+    );
+    assert compiled.bind({'cap': 0}).params['cap'] == 0;
+    for values in [{'cap': -1}, {'cap': True}, {}, {'cap': 1.2}] {
+        rejected = False;
+        try {
+            compiled.bind(values);
+        } except q.SqlError {
+            rejected = True;
+        }
+        assert rejected , str(values);
+    }
+}
+
+test "Actual compiler checkpoint includes deterministic SQL descriptors" {
+    import from jaclang.runtime.ttg { JacTTGGenerator }
+    arch = JacTTGGenerator._find_walker_ast_node(FrontierWalk);
+    assert arch is not None;
+    first = compile_checkpoint_plan(arch);
+    second = compile_checkpoint_plan(arch);
+    assert first == second;
+    assert first['sql_templates']['version'] == 1;
+    restored = checkpoint_graph(json.loads(json.dumps(first)), FrontierWalk);
+    assert restored.sql_templates['batch']['gated']['_compiled'].sql
+        == first['sql_templates']['batch']['gated']['sql'];
+    assert 'unnest(' in first['sql_templates']['batch']['open']['sql'];
+}
+
+test "Selected hydrated compiled paths bind cold and warm with no SQL AST construction" {
+    graph = analyze_walker_dependencies(FrontierWalk);
+    template_metrics(True, True);
+    emitted = compile_templates(graph.events);
+    metrics = template_metrics();
+    assert metrics['generation_calls'] == 1;
+    assert metrics['emitted_artifact_bytes'] > metrics['emitted_sql_bytes'] > 0;
+    bundle = hydrate_templates(json.loads(json.dumps(emitted)));
+    template_metrics(True, False);
+    with patch.object(q, 'table', side_effect=AssertionError('runtime AST table')) {
+        with patch.object(
+            q, 'compile_sql', side_effect=AssertionError('runtime SQL renderer')
+        ) {
+            for warm in (False, True) {
+                descriptor = select_template(bundle, 'batch', True);
+                values: dict = {
+                    'actor_uuid': UUID(int=3),
+                    'actor_text': str(UUID(int=3)),
+                    'row_limit': 21
+                };
+                for (slot, site) in enumerate(bundle['sites']) {
+                    values['origins_' + str(slot)] = (UUID(int=slot + 1), );
+                }
+                bound = bind_template(descriptor, values);
+                assert bound.sql == descriptor['sql'];
+                assert bound.params['row_limit'] == 21;
+            }
+        }
+    }
+}
+
+test "Disengage overfetch assumption preserves later queued origin prediction only" {
+    graph = analyze_walker_dependencies(FrontierCancel);
+    (event, current) = entry_current(graph, 'branch');
+    current['facts'] = {'value': 1};
+    current['transition_state'] = {'branch::here.value': 1, 'self.entered::list': True};
+    pending = [{'id': 'c', 'node_type': FrontierBranch, 'facts': {'value': 0}}];
+    (prediction, demands) = collect_frontier(graph, current, event, pending, 20);
+    assert [a['id'] for (a, e) in demands] == ['c'] , str(prediction);
+}
+
+test "Unknown queued branch state stops before inventing visits" {
+    graph = analyze_walker_dependencies(FrontierCancel);
+    (event, current) = entry_current(graph, 'branch');
+    current['facts'] = {'value': 0};
+    current['transition_state'] = {'branch::here.value': 0, 'self.entered::list': True};
+    (prediction, demands) = collect_frontier(
+        graph, current, event, [{'id': 'unknown', 'node_type': FrontierBranch}], 20
+    );
+    assert [a['id'] for (a, e) in demands] == ['b'];
+    assert not prediction['complete'];
+}
+
+test "Compiled cache publication and native consumption do not build SQL and preserve duplicate rows" {
+    import from threading { RLock }
+    import from unittest.mock { MagicMock }
+    import from jaclang.runtime.ttg_templates { publish_paths }
+    import from jaclang.runtime.graph_query { GraphQuery, QHop }
+    import from jaclang.data.query_planner { _sql_pairs }
+    import jaclang.data.query_planner as planner;
+    import jaclang.runtime.graph_walk as walk;
+    import from .fixtures.ttg_frontier_walkers { FrontierRight, FrontierLeaf }
+    graph = analyze_walker_dependencies(FrontierDuplicate);
+    bundle = hydrate_templates(compile_templates(graph.events));
+    event = next(
+        e
+        for e in graph.events
+        if e.kind == 'visit'
+    );
+    query = GraphQuery(
+        [], hops=[QHop(dir=2, `edge=FrontierRight, nd=FrontierLeaf)]
+    ).`visit();
+    cache: dict = {};
+    mem: any = MagicMock();
+    mem._lock = RLock();
+    mem.query_cache_get.side_effect = cache.get;
+    mem.query_cache_put.side_effect = cache.__setitem__;
+    origin = UUID(int=1);
+    rows = [
+        (UUID(int=2), UUID(int=3), 'FrontierLeaf', FrontierLeaf.__module__),
+        (UUID(int=2), UUID(int=4), 'FrontierLeaf', FrontierLeaf.__module__)
+    ];
+    descriptors = select_template(bundle, 'native', False, event.id);
+    with patch.object(planner, '_acl_pushdown_root', return_value=None), patch.object(
+        planner, 'access_gated', return_value=False
+    ), patch.object(walk, 'access_gated', return_value=False) {
+        with patch.object(q, 'table', side_effect=AssertionError('runtime AST')) {
+            with patch.object(
+                q, 'compile_sql', side_effect=AssertionError('runtime renderer')
+            ) {
+                with patch.object(
+                    planner,
+                    'compile_query',
+                    side_effect=AssertionError('runtime native builder')
+                ) {
+                    assert publish_paths(mem, [(query, origin, rows, descriptors)]);
+                    (pairs, tail) = _sql_pairs(mem, [origin], query, 1);
+                    assert pairs
+                        == [(UUID(int=2), UUID(int=3)), (UUID(int=2), UUID(int=4))];
+                    assert tail == [];
+                    assert publish_paths(mem, [(query, UUID(int=9), [], descriptors)]);
+                    assert _sql_pairs(mem, [UUID(int=9)], query, 1) == ([], []);
