class like_tweet(find_tweet, Walker):

    @on_entry
    @set_trigger(lambda: Tweet)
    def act(self, here: Tweet) -> None:
        ttg_prefetch_observe(self, '{"version":2,"walker_name":"like_tweet","entries":{"act":0},"handlers":{"Tweet":["act"]},"dispatch":{},"candidates":[],"points":[],"events":[{"id":0,"kind":"entry","ability":"act","line":468,"column":5,"expression":"","writes":"","reads":[],"targets":[],"hop_chain":[],"origin":"here","next_id":1,"true_id":-1,"false_id":-1,"definitions":{}},{"id":1,"kind":"barrier","ability":"act","line":469,"column":9,"expression":"","writes":"","reads":[],"targets":[],"hop_chain":[],"origin":"here","next_id":2,"true_id":-1,"false_id":-1,"definitions":{}},{"id":2,"kind":"exit","ability":"act","line":468,"column":5,"expression":"","writes":"","reads":[],"targets":[],"hop_chain":[],"origin":"here","next_id":-1,"true_id":-1,"false_id":-1,"definitions":{}}],"edges":[{"source":0,"target":1,"kind":"order","label":"","context":-1},{"source":1,"target":2,"kind":"order","label":"","context":-1}]}', 0, __class__)
        if jid(here) == self.tweet_id:
            if self.actor in here.likes:
                here.likes = [u for u in here.likes if u != self.actor]
                log_report({'liked': False, 'likes': here.likes})
            else:
                here.likes = here.likes + [self.actor]
                log_report({'liked': True, 'likes': here.likes})
            disengage(self)
            return

