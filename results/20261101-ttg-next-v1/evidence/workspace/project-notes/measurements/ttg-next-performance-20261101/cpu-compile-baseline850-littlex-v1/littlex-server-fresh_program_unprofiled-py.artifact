class create_channel_tweet(find_channel, Walker):
    content: str = ''

    @on_entry
    @set_trigger(lambda: Channel)
    def act(self, here: Channel) -> None:
        ttg_prefetch_observe(self, '{"version":2,"walker_name":"create_channel_tweet","entries":{"act":0},"handlers":{"Channel":["act"]},"dispatch":{},"candidates":[],"points":[],"events":[{"id":0,"kind":"entry","ability":"act","line":567,"column":5,"expression":"","writes":"","reads":[],"targets":[],"hop_chain":[],"origin":"here","next_id":1,"true_id":-1,"false_id":-1,"definitions":{}},{"id":1,"kind":"barrier","ability":"act","line":568,"column":9,"expression":"","writes":"","reads":[],"targets":[],"hop_chain":[],"origin":"here","next_id":2,"true_id":-1,"false_id":-1,"definitions":{}},{"id":2,"kind":"exit","ability":"act","line":567,"column":5,"expression":"","writes":"","reads":[],"targets":[],"hop_chain":[],"origin":"here","next_id":-1,"true_id":-1,"false_id":-1,"definitions":{}}],"edges":[{"source":0,"target":1,"kind":"order","label":"","context":-1},{"source":1,"target":2,"kind":"order","label":"","context":-1}]}', 0, __class__)
        if jid(here) == self.channel_id:
            me = refs(GraphQuery(root(), hops=[QHop(dir=2, nd=Profile)]))[0]
            if refs(GraphQuery(me, hops=[QHop(dir=2, edge=Member, only=here)], edges_only=True), lazy=True):
                new_tweet = connect(left=here, right=Tweet(content=self.content, author_username=me.username, created_at=_now()), edge=ChannelPost())
                grant(new_tweet, level=AccessLevel.WRITE)
                log_report(new_tweet.to_view())
            disengage(self)
            return

def _dbridge_like_store() -> Any:
    ctx = Jac.get_context()
    mem = ctx.mem
    if mem is None or mem.store is None:
        raise RuntimeError('dbridge_like requires a persisted PgSQL store')
    mem.read_barrier()
    return mem.store

def _dbridge_like_jac_id(value: Any) -> str:
    return jid(value)

def _dbridge_like_remember(order: list[str], seen: set[str], uid: str) -> None:
    if uid and uid not in seen:
        seen.add(uid)
        order.append(uid)

def _dbridge_like_write_uuid_list(path: str, ids: list[str]) -> None:
    if not path:
        return
    p = Path(path)
    p.parent.mkdir(parents=True, exist_ok=True)
    p.write_text(''.join([f'{uid}\n' for uid in ids]))

def _dbridge_like_quality(actual_order: list[str], prefetched_order: list[str]) -> dict:
    actual = set(actual_order)
    prefetched = set(prefetched_order)
    covered = len(actual & prefetched)
    overfetch = len(prefetched - actual)
    undercoverage = len(actual - prefetched)
    coverage = covered * 100.0 / len(actual) if actual else 100.0
    accuracy = covered * 100.0 / len(prefetched) if prefetched else 100.0
    return {'covered': covered, 'overfetch': overfetch, 'undercoverage': undercoverage, 'coverage': coverage, 'accuracy': accuracy}

def _dbridge_like_profile_paths() -> dict[str, str]:
    return {'profile_dir': os.environ.get('JAC_DBRIDGE_LIKE_PROFILE_DIR', '').strip() or os.environ.get('JAC_PROFILE_DIR', '').strip(), 'profile_csv': os.environ.get('JAC_DBRIDGE_LIKE_PROFILE_CSV', '').strip() or os.environ.get('JAC_PROFILE_CSV', '').strip()}

def _dbridge_like_write_profile(profile_dir: str, profile_csv: str, profiler: Any, e2e_ms: float, prefetch_ms: float, walker_ms: float, materialize_ms: float, prefetch_wait_ms: float) -> None:
    out_dir = Path(profile_dir) if profile_dir else Path(profile_csv).parent if profile_csv else None
    if out_dir is None:
        return
    out_dir.mkdir(parents=True, exist_ok=True)
    if profiler is not None:
        profiler.disable()
        prof_path = out_dir / 'jac_server.prof'
        txt_path = out_dir / 'jac_server.txt'
        profiler.dump_stats(str(prof_path))
        txt_path.write_text(f'Profile saved to {prof_path}\n')
    csv_path = Path(profile_csv) if profile_csv else out_dir / 'profile.csv'
    csv_path.parent.mkdir(parents=True, exist_ok=True)
    csv_path.write_text('node_num,edge_num,tweet_num,ttg_enabled,ttg_total_ms,topo_idx_ms,ttg_ms,prefetch_ms,walker_ms,resolve_total_ms,materialize_ms,prefetch_wait_ms\n' + f',,,dbridge_like,{e2e_ms:.3f},0.000,0.000,{prefetch_ms:.3f},{walker_ms:.3f},0.000,{materialize_ms:.3f},{prefetch_wait_ms:.3f}\n')

def _dbridge_like_batch_get(ids: list[str]) -> dict[str, Any]:
    if not ids:
        return {}
    ctx = Jac.get_context()
    mem = ctx.mem
    if mem is None:
        raise RuntimeError('dbridge_like requires an active Jac memory session')
    uuid_ids: list[UUID] = []
    seen: set[str] = set()
    for uid in ids:
        if uid and uid not in seen:
            seen.add(uid)
            uuid_ids.append(UUID(uid))
    anchors = mem.batch_get(uuid_ids)
    out: dict[str, Any] = {}
    for uid in ids:
        if uid:
            anchor = anchors.get(UUID(uid))
            if anchor is not None and cast(Any, anchor).archetype is not None:
                out[uid] = cast(Any, anchor).archetype
    return out

def _dbridge_like_batch_tweets(ids: list[str], context: str) -> dict[str, Tweet]:
    materialized = _dbridge_like_batch_get(ids)
    tweets: dict[str, Tweet] = {}
    for uid in ids:
        tweet = cast(Tweet | None, materialized.get(uid))
        if tweet is None:
            raise ValueError(f'Tweet not found during dbridge_like {context}: {uid}')
        tweets[uid] = tweet
    return tweets

def _dbridge_like_empty_feed_result(root_id: str, e2e_ms: float, db_ms: float, access_log: str, actual_file: str, prefetch_file: str, query_count: int) -> dict[str, Any]:
    reports: list[list[TweetView]] = [[]]
    return {'reports': reports, 'metrics': {'policy': 'dbridge_like', 'prefetch_limit': 0, 'trial': 0, 'start_id': root_id, 'visited': 0, 'checksum': 0, 'first_value': '', 'last_value': '', 'e2e_ms': f'{e2e_ms:.3f}', 'db_ms': f'{db_ms:.3f}', 'materialize_ms': '0.000', 'cpu_ms': f'{e2e_ms:.3f}', 'prefetch_ms': '0.000', 'prefetch_wait_ms': '0.000', 'query_count': query_count, 'l1': 0, 'l2': 0, 'l3': 0, 'miss': 0, 'actual_ids': 0, 'prefetched_ids': 0, 'covered_ids': 0, 'overfetch_ids': 0, 'undercoverage_ids': 0, 'coverage': '100.0', 'accuracy': '100.0', 'serialized_bytes': 2, 'access_log': access_log, 'actual_file': actual_file, 'prefetch_file': prefetch_file, 'error': ''}}

def _dbridge_like_root_profile_id(root_id: str) -> str:
    rows = _dbridge_like_store().rows("\n        SELECT e.dst::text\n        FROM anchors e\n        JOIN anchors dst ON dst.id = e.dst\n        WHERE e.kind = 'EdgeAnchor'\n          AND e.src = CAST(:src AS uuid)\n          AND dst.kind = 'NodeAnchor'\n          AND dst.arch_type = 'Profile'\n        ORDER BY e.seq NULLS LAST, e.id\n        LIMIT 1\n        ", {'src': root_id})
    return str(rows[0][0]) if rows else ''

def _dbridge_like_feed_tweet_ids(profile_id: str) -> list[str]:
    rows = _dbridge_like_store().rows("\n        SELECT tweet_id\n        FROM (\n            SELECT\n                0 AS path_rank,\n                NULL::bigint AS follow_seq,\n                NULL::uuid AS follow_id,\n                e.seq AS post_seq,\n                e.id AS post_id,\n                e.dst::text AS tweet_id\n            FROM anchors e\n            JOIN anchors dst ON dst.id = e.dst\n            WHERE e.kind = 'EdgeAnchor'\n              AND e.src = CAST(:src AS uuid)\n              AND e.arch_type = 'Post'\n              AND dst.kind = 'NodeAnchor'\n              AND dst.arch_type = 'Tweet'\n            UNION ALL\n            SELECT\n                1 AS path_rank,\n                follow.seq AS follow_seq,\n                follow.id AS follow_id,\n                post.seq AS post_seq,\n                post.id AS post_id,\n                post.dst::text AS tweet_id\n            FROM anchors follow\n            JOIN anchors followed ON followed.id = follow.dst\n            JOIN anchors post ON post.src = follow.dst\n            JOIN anchors tweet ON tweet.id = post.dst\n            WHERE follow.kind = 'EdgeAnchor'\n              AND follow.src = CAST(:src AS uuid)\n              AND follow.arch_type = 'Follow'\n              AND followed.kind = 'NodeAnchor'\n              AND followed.arch_type = 'Profile'\n              AND post.kind = 'EdgeAnchor'\n              AND post.arch_type = 'Post'\n              AND tweet.kind = 'NodeAnchor'\n              AND tweet.arch_type = 'Tweet'\n        ) feed_refs\n        ORDER BY path_rank,\n                 follow_seq NULLS LAST,\n                 follow_id NULLS LAST,\n                 post_seq NULLS LAST,\n                 post_id\n        ", {'src': profile_id})
    return [str(r[0]) for r in rows]

def _dbridge_like_prefetch_feed_tweets(profile_id: str) -> dict[str, Any]:
    started = time.perf_counter()
    db_start = time.perf_counter()
    tweet_ids = _dbridge_like_feed_tweet_ids(profile_id)
    db_ms = (time.perf_counter() - db_start) * 1000.0
    materialize_start = time.perf_counter()
    tweets_by_id = _dbridge_like_batch_tweets(tweet_ids, 'prefetch')
    materialize_ms = (time.perf_counter() - materialize_start) * 1000.0
    return {'tweet_ids': tweet_ids, 'tweets_by_id': tweets_by_id, 'db_ms': db_ms, 'materialize_ms': materialize_ms, 'elapsed_ms': (time.perf_counter() - started) * 1000.0, 'query_count': 1}

def _submit_dbridge_like_feed_tweets(profile_id: str) -> Any:
    ctx = contextvars.copy_context()
    return _DBRIDGE_LIKE_EXECUTOR.submit(ctx.run, _dbridge_like_prefetch_feed_tweets, profile_id)

@restspec(method=HTTPMethod.POST, path='/dbridge_like/load_feed')
def dbridge_like_load_feed(search_query: str='') -> dict[str, Any]:
    access_log = os.environ.get('JAC_DBRIDGE_LIKE_ACCESS_LOG', '').strip()
    cfg = get_config()
    if not access_log and cfg is not None:
        access_log = str(cast(Any, cfg).run.access_log or '')
    actual_file = os.environ.get('JAC_DBRIDGE_LIKE_ACTUAL_FILE', '').strip()
    prefetch_file = os.environ.get('JAC_DBRIDGE_LIKE_PREFETCH_FILE', '').strip()
    paths = _dbridge_like_profile_paths()
    profile_dir = paths['profile_dir']
    profile_csv = paths['profile_csv']
    if not actual_file:
        raise ValueError('JAC_DBRIDGE_LIKE_ACTUAL_FILE is required')
    if not prefetch_file:
        raise ValueError('JAC_DBRIDGE_LIKE_PREFETCH_FILE is required')
    if access_log and cfg is not None:
        cast(Any, cfg).run.access_log = access_log
        _access_log_reset_for_tests()
    profile_out_dir = Path(profile_dir) if profile_dir else Path(profile_csv).parent if profile_csv else None
    profiler: Any = None
    if profile_out_dir is not None:
        profile_out_dir.mkdir(parents=True, exist_ok=True)
        profiler = cProfile.Profile()
        profiler.enable()
    hit_stats_reset()
    trial_start = time.perf_counter()
    actual_order: list[str] = []
    actual_seen: set[str] = set()
    prefetched_order: list[str] = []
    prefetched_seen: set[str] = set()
    feed: list[TweetView] = []
    db_ms: float = 0.0
    materialize_ms: float = 0.0
    prefetch_ms: float = 0.0
    prefetch_wait_ms: float = 0.0
    query_count: int = 0
    root_id = _dbridge_like_jac_id(Jac.root())
    db_start = time.perf_counter()
    profile_id = _dbridge_like_root_profile_id(root_id)
    db_ms += (time.perf_counter() - db_start) * 1000.0
    query_count += 1
    if not profile_id:
        e2e_ms = (time.perf_counter() - trial_start) * 1000.0
        _dbridge_like_write_uuid_list(actual_file, actual_order)
        _dbridge_like_write_uuid_list(prefetch_file, prefetched_order)
        _dbridge_like_write_profile(profile_dir, profile_csv, profiler, e2e_ms, prefetch_ms, e2e_ms, materialize_ms, prefetch_wait_ms)
        return _dbridge_like_empty_feed_result(root_id, e2e_ms, db_ms, access_log, actual_file, prefetch_file, query_count)
    materialize_start = time.perf_counter()
    profile = cast(Profile | None, _dbridge_like_batch_get([profile_id]).get(profile_id))
    materialize_ms += (time.perf_counter() - materialize_start) * 1000.0
    if profile is None:
        raise ValueError(f'Profile not found during dbridge_like traversal: {profile_id}')
    _dbridge_like_remember(actual_order, actual_seen, profile_id)
    my_username = profile.username
    feed_future = _submit_dbridge_like_feed_tweets(profile_id)
    wait_start = time.perf_counter()
    feed_prefetch = feed_future.result()
    prefetch_wait_ms += (time.perf_counter() - wait_start) * 1000.0
    db_ms += float(feed_prefetch['db_ms'])
    materialize_ms += float(feed_prefetch['materialize_ms'])
    prefetch_ms += float(feed_prefetch['elapsed_ms'])
    query_count += int(feed_prefetch['query_count'])
    tweet_ids = cast(list[str], feed_prefetch['tweet_ids'])
    tweets_by_id = cast(dict[str, Tweet], feed_prefetch['tweets_by_id'])
    for tweet_id in tweet_ids:
        tweet = tweets_by_id[tweet_id]
        _dbridge_like_remember(prefetched_order, prefetched_seen, tweet_id)
        _dbridge_like_remember(actual_order, actual_seen, tweet_id)
        feed.append(TweetView(id=tweet_id, content=tweet.content, author_username=tweet.author_username, created_at=tweet.created_at, likes=tweet.likes, comments=tweet.comments, is_mine=tweet.author_username == my_username))
    result = feed
    if search_query:
        q = search_query.lower().strip()
        result = [t for t in result if q in t.content.lower()]
    result.sort(key=lambda t: t.created_at, reverse=True)
    reports = [result]
    e2e_ms = (time.perf_counter() - trial_start) * 1000.0
    walker_ms = e2e_ms - prefetch_wait_ms
    quality = _dbridge_like_quality(actual_order, prefetched_order)
    hits = hit_stats_snapshot()
    l1 = int(hits.get('L1', 0))
    l2 = int(hits.get('L2', 0))
    l3 = int(hits.get('L3', 0))
    miss = int(hits.get('MISS', 0))
    checksum = 0
    for view in result:
        checksum += len(view.content)
    serialized = json.dumps(reports, separators=(',', ':'), default=str)
    _dbridge_like_write_uuid_list(actual_file, actual_order)
    _dbridge_like_write_uuid_list(prefetch_file, prefetched_order)
    _dbridge_like_write_profile(profile_dir, profile_csv, profiler, e2e_ms, prefetch_ms, walker_ms, materialize_ms, prefetch_wait_ms)
    return {'reports': reports, 'metrics': {'policy': 'dbridge_like', 'prefetch_limit': 0, 'trial': 0, 'start_id': root_id, 'visited': len(result), 'checksum': checksum, 'first_value': result[0].id if result else '', 'last_value': result[-1].id if result else '', 'e2e_ms': f'{e2e_ms:.3f}', 'db_ms': f'{db_ms:.3f}', 'materialize_ms': f'{materialize_ms:.3f}', 'cpu_ms': f'{walker_ms:.3f}', 'prefetch_ms': f'{prefetch_ms:.3f}', 'prefetch_wait_ms': f'{prefetch_wait_ms:.3f}', 'query_count': query_count, 'l1': l1, 'l2': l2, 'l3': l3, 'miss': miss, 'actual_ids': len(actual_order), 'prefetched_ids': len(prefetched_order), 'covered_ids': quality['covered'], 'overfetch_ids': quality['overfetch'], 'undercoverage_ids': quality['undercoverage'], 'coverage': f"{quality['coverage']:.1f}", 'accuracy': f"{quality['accuracy']:.1f}", 'serialized_bytes': len(serialized.encode('utf-8')), 'access_log': access_log, 'actual_file': actual_file, 'prefetch_file': prefetch_file, 'error': ''}}
