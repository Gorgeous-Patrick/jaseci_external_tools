"""Little X - Social graph backend in idiomatic object-spatial style.

The graph holds the data: `Profile` / `Tweet` / `Channel` nodes wired by
typed edges. Walkers are the mobile agents the client spawns - each one
declares where it starts (`with Root entry`) and what to do at every node
type it lands on (`with Tweet entry`, ...). Traversal is `visit`, never a
hand-rolled loop, and shared fan-out lives in small base walkers.
"""
from __future__ import annotations
from jaclang.runtime.builtin import AccessLevel, allroots, grant, jid, jobj, restspec
from typing import Any
from jaclang.lib.jaclib import Edge, GraphQuery, Node, Obj, QHop, Root, Walker, build_edge, connect, destroy, disengage, field, log_report, on_entry, on_exit, refs, root, set_trigger, ttg_checkpoint, ttg_prefetch_observe, visit
import cProfile
import contextvars
import datetime
import json
import os
import time
from concurrent.futures import ThreadPoolExecutor
from http import HTTPMethod
from pathlib import Path
from typing import cast
from uuid import UUID
from jaclang import JacRuntimeInterface as Jac
from jaclang.project.config import get_config
from jaclang.runtime.archetype import AccessLevel
from jaclang.runtime.builtin import restspec
from jaclang.server.session import _access_log_reset_for_tests, hit_stats_reset, hit_stats_snapshot
_DBRIDGE_LIKE_EXECUTOR: Any = ThreadPoolExecutor(max_workers=int(os.environ.get('JAC_DBRIDGE_LIKE_WORKERS', '4')))

def _now() -> str:
    return datetime.datetime.now(datetime.UTC).replace(tzinfo=None).isoformat() + 'Z'

class UserView(Obj):
    id: str
    username: str
    bio: str = ''

class TweetView(Obj):
    id: str
    content: str
    author_username: str
    created_at: str
    likes: list[str]
    comments: list[dict[str, str]]
    is_mine: bool = False

class ProfileView(Obj):
    id: str
    username: str
    bio: str
    followers: list[UserView]
    following: list[UserView]
    tweets: list[TweetView]

class ChannelView(Obj):
    id: str
    name: str
    description: str
    creator_username: str
    created_at: str
    member_count: int
    is_member: bool
    posts: list[TweetView] = field(factory=lambda: [])

class TrendingTag(Obj):
    tag: str
    count: int

class Follow(Edge):
    pass

class Post(Edge):
    pass

class Member(Edge):
    pass

class ChannelPost(Edge):
    pass

class Profile(Node):
    username: str = ''
    bio: str = ''
    created_at: str = ''

    def to_user_view(self) -> UserView:
        return UserView(id=jid(self), username=self.username, bio=self.bio)

    def to_profile_view(self) -> ProfileView:
        followers = [p.to_user_view() for p in refs(GraphQuery(self, hops=[QHop(dir=1, edge=Follow, nd=Profile)]))]
        following = [p.to_user_view() for p in refs(GraphQuery(self, hops=[QHop(dir=2, edge=Follow, nd=Profile)]))]
        tweets = [t.to_view() for t in refs(GraphQuery(self, hops=[QHop(dir=2, nd=Tweet)]))]
        tweets.sort(key=lambda t: t.created_at, reverse=True)
        return ProfileView(id=jid(self), username=self.username, bio=self.bio, followers=followers, following=following, tweets=tweets)

class Tweet(Node):
    content: str = ''
    author_username: str = ''
    created_at: str = ''
    likes: list[str] = field(factory=lambda: [])
    comments: list[dict[str, str]] = field(factory=lambda: [])

    def to_view(self) -> TweetView:
        mine = refs(GraphQuery(root(), hops=[QHop(dir=2, nd=Profile)]))
        is_mine: bool = len(mine) > 0 and self.author_username == mine[0].username
        return TweetView(id=jid(self), content=self.content, author_username=self.author_username, created_at=self.created_at, likes=self.likes, comments=self.comments, is_mine=is_mine)

class Channel(Node):
    name: str = ''
    description: str = ''
    creator_username: str = ''
    created_at: str = ''

    def to_view(self, with_posts: bool) -> ChannelView:
        mine = refs(GraphQuery(root(), hops=[QHop(dir=2, nd=Profile)]))
        is_member: bool = len(mine) > 0 and len(refs(GraphQuery(mine[0], hops=[QHop(dir=2, edge=Member, only=self)], edges_only=True), lazy=True)) > 0
        posts: list[TweetView] = []
        if with_posts:
            posts = [t.to_view() for t in refs(GraphQuery(self, hops=[QHop(dir=2, nd=Tweet)]))]
            posts.sort(key=lambda t: t.created_at, reverse=True)
        return ChannelView(id=jid(self), name=self.name, description=self.description, creator_username=self.creator_username, created_at=self.created_at, member_count=len(refs(GraphQuery(self, hops=[QHop(dir=1, edge=Member, nd=Profile)]), lazy=True)), is_member=is_member, posts=posts)

