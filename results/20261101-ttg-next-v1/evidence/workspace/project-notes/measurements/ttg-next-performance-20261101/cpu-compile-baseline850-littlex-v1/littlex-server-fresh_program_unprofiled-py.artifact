        ttg_prefetch_observe(self, '{"version":2,"walker_name":"delete_tweet","entries":{"act":0},"handlers":{"Tweet":["act"]},"dispatch":{},"candidates":[],"points":[],"events":[{"id":0,"kind":"entry","ability":"act","line":487,"column":5,"expression":"","writes":"","reads":[],"targets":[],"hop_chain":[],"origin":"here","next_id":1,"true_id":-1,"false_id":-1,"definitions":{}},{"id":1,"kind":"barrier","ability":"act","line":488,"column":9,"expression":"","writes":"","reads":[],"targets":[],"hop_chain":[],"origin":"here","next_id":2,"true_id":-1,"false_id":-1,"definitions":{}},{"id":2,"kind":"exit","ability":"act","line":487,"column":5,"expression":"","writes":"","reads":[],"targets":[],"hop_chain":[],"origin":"here","next_id":-1,"true_id":-1,"false_id":-1,"definitions":{}}],"edges":[{"source":0,"target":1,"kind":"order","label":"","context":-1},{"source":1,"target":2,"kind":"order","label":"","context":-1}]}', 0, __class__)
        if jid(here) == self.tweet_id and here.author_username == self.actor:
            destroy([here])
            del here
            log_report({'success': True})
            disengage(self)
            return

class add_comment(find_tweet, Walker):
    content: str = ''

    @on_entry
    @set_trigger(lambda: Tweet)
    def act(self, here: Tweet) -> None:
        ttg_prefetch_observe(self, '{"version":2,"walker_name":"add_comment","entries":{"act":0},"handlers":{"Tweet":["act"]},"dispatch":{},"candidates":[],"points":[],"events":[{"id":0,"kind":"entry","ability":"act","line":499,"column":5,"expression":"","writes":"","reads":[],"targets":[],"hop_chain":[],"origin":"here","next_id":1,"true_id":-1,"false_id":-1,"definitions":{}},{"id":1,"kind":"barrier","ability":"act","line":500,"column":9,"expression":"","writes":"","reads":[],"targets":[],"hop_chain":[],"origin":"here","next_id":2,"true_id":-1,"false_id":-1,"definitions":{}},{"id":2,"kind":"exit","ability":"act","line":499,"column":5,"expression":"","writes":"","reads":[],"targets":[],"hop_chain":[],"origin":"here","next_id":-1,"true_id":-1,"false_id":-1,"definitions":{}}],"edges":[{"source":0,"target":1,"kind":"order","label":"","context":-1},{"source":1,"target":2,"kind":"order","label":"","context":-1}]}', 0, __class__)
        if jid(here) == self.tweet_id:
            comment = {'username': self.actor, 'content': self.content, 'created_at': _now()}
            here.comments = here.comments + [comment]
            log_report({'success': True, 'comment': comment})
            disengage(self)
            return

class find_channel(Walker):
    channel_id: str = ''

    @on_entry
    @set_trigger(lambda: Root)
    def run(self, here: Root) -> None:
        ttg_prefetch_observe(self, '{"version":2,"walker_name":"find_channel","entries":{"run":0},"handlers":{"Root":["run"]},"dispatch":{},"candidates":["run"],"points":[],"events":[{"id":0,"kind":"entry","ability":"run","line":516,"column":5,"expression":"","writes":"","reads":[],"targets":[],"hop_chain":[],"origin":"here","next_id":1,"true_id":-1,"false_id":-1,"definitions":{}},{"id":1,"kind":"branch","ability":"run","line":517,"column":9,"expression":"self . channel_id","writes":"","reads":["self.channel_id"],"targets":[],"hop_chain":[],"origin":"here","next_id":-1,"true_id":3,"false_id":5,"definitions":{}},{"id":2,"kind":"input","ability":"run","line":517,"column":0,"expression":"","writes":"self.channel_id","reads":[],"targets":[],"hop_chain":[],"origin":"here","next_id":-1,"true_id":-1,"false_id":-1,"definitions":{}},{"id":3,"kind":"barrier","ability":"run","line":518,"column":13,"expression":"","writes":"","reads":[],"targets":[],"hop_chain":[],"origin":"here","next_id":4,"true_id":-1,"false_id":-1,"definitions":{}},{"id":4,"kind":"barrier","ability":"run","line":519,"column":13,"expression":"","writes":"","reads":[],"targets":[],"hop_chain":[],"origin":"here","next_id":5,"true_id":-1,"false_id":-1,"definitions":{}},{"id":5,"kind":"join","ability":"run","line":517,"column":9,"expression":"","writes":"","reads":[],"targets":[],"hop_chain":[],"origin":"here","next_id":6,"true_id":-1,"false_id":-1,"definitions":{}},{"id":6,"kind":"exit","ability":"run","line":516,"column":5,"expression":"","writes":"","reads":[],"targets":[],"hop_chain":[],"origin":"here","next_id":-1,"true_id":-1,"false_id":-1,"definitions":{}}],"edges":[{"source":2,"target":1,"kind":"data","label":"self.channel_id","context":-1},{"source":1,"target":3,"kind":"control","label":"true","context":-1},{"source":0,"target":1,"kind":"order","label":"","context":-1},{"source":1,"target":3,"kind":"order","label":"","context":-1},{"source":1,"target":5,"kind":"order","label":"","context":-1},{"source":3,"target":4,"kind":"order","label":"","context":-1},{"source":4,"target":5,"kind":"order","label":"","context":-1},{"source":5,"target":6,"kind":"order","label":"","context":-1}]}', 0, __class__)
        if self.channel_id:
            target = jobj(self.channel_id)
            if isinstance(target, Channel):
                visit(self, [target])

class join_channel(find_channel, Walker):

    @on_entry
    @set_trigger(lambda: Channel)
    def act(self, here: Channel) -> None:
        ttg_prefetch_observe(self, '{"version":2,"walker_name":"join_channel","entries":{"act":0},"handlers":{"Channel":["act"]},"dispatch":{},"candidates":[],"points":[],"events":[{"id":0,"kind":"entry","ability":"act","line":527,"column":5,"expression":"","writes":"","reads":[],"targets":[],"hop_chain":[],"origin":"here","next_id":1,"true_id":-1,"false_id":-1,"definitions":{}},{"id":1,"kind":"barrier","ability":"act","line":528,"column":9,"expression":"","writes":"","reads":[],"targets":[],"hop_chain":[],"origin":"here","next_id":2,"true_id":-1,"false_id":-1,"definitions":{}},{"id":2,"kind":"exit","ability":"act","line":527,"column":5,"expression":"","writes":"","reads":[],"targets":[],"hop_chain":[],"origin":"here","next_id":-1,"true_id":-1,"false_id":-1,"definitions":{}}],"edges":[{"source":0,"target":1,"kind":"order","label":"","context":-1},{"source":1,"target":2,"kind":"order","label":"","context":-1}]}', 0, __class__)
        if jid(here) == self.channel_id:
            me = refs(GraphQuery(root(), hops=[QHop(dir=2, nd=Profile)]))[0]
            if not refs(GraphQuery(me, hops=[QHop(dir=2, edge=Member, only=here)], edges_only=True), lazy=True):
                connect(left=me, right=here, edge=Member())
            log_report({'success': True})
            disengage(self)
            return

class leave_channel(find_channel, Walker):

    @on_entry
    @set_trigger(lambda: Channel)
    def act(self, here: Channel) -> None:
        ttg_prefetch_observe(self, '{"version":2,"walker_name":"leave_channel","entries":{"act":0},"handlers":{"Channel":["act"]},"dispatch":{},"candidates":[],"points":[],"events":[{"id":0,"kind":"entry","ability":"act","line":540,"column":5,"expression":"","writes":"","reads":[],"targets":[],"hop_chain":[],"origin":"here","next_id":1,"true_id":-1,"false_id":-1,"definitions":{}},{"id":1,"kind":"barrier","ability":"act","line":541,"column":9,"expression":"","writes":"","reads":[],"targets":[],"hop_chain":[],"origin":"here","next_id":2,"true_id":-1,"false_id":-1,"definitions":{}},{"id":2,"kind":"exit","ability":"act","line":540,"column":5,"expression":"","writes":"","reads":[],"targets":[],"hop_chain":[],"origin":"here","next_id":-1,"true_id":-1,"false_id":-1,"definitions":{}}],"edges":[{"source":0,"target":1,"kind":"order","label":"","context":-1},{"source":1,"target":2,"kind":"order","label":"","context":-1}]}', 0, __class__)
        if jid(here) == self.channel_id:
            me = refs(GraphQuery(root(), hops=[QHop(dir=2, nd=Profile)]))[0]
            edges = refs(GraphQuery(me, hops=[QHop(dir=2, edge=Member, only=here)], edges_only=True))
            if edges:
                destroy([edges[0]])
                del edges[0]
            log_report({'success': True})
            disengage(self)
            return

class get_channel_detail(find_channel, Walker):
    reports: list[ChannelView] = field(factory=lambda: [])

    @on_entry
    @set_trigger(lambda: Channel)
    def act(self, here: Channel) -> None:
        ttg_prefetch_observe(self, '{"version":2,"walker_name":"get_channel_detail","entries":{"act":0},"handlers":{"Channel":["act"]},"dispatch":{},"candidates":[],"points":[],"events":[{"id":0,"kind":"entry","ability":"act","line":556,"column":5,"expression":"","writes":"","reads":[],"targets":[],"hop_chain":[],"origin":"here","next_id":1,"true_id":-1,"false_id":-1,"definitions":{}},{"id":1,"kind":"barrier","ability":"act","line":557,"column":9,"expression":"","writes":"","reads":[],"targets":[],"hop_chain":[],"origin":"here","next_id":2,"true_id":-1,"false_id":-1,"definitions":{}},{"id":2,"kind":"exit","ability":"act","line":556,"column":5,"expression":"","writes":"","reads":[],"targets":[],"hop_chain":[],"origin":"here","next_id":-1,"true_id":-1,"false_id":-1,"definitions":{}}],"edges":[{"source":0,"target":1,"kind":"order","label":"","context":-1},{"source":1,"target":2,"kind":"order","label":"","context":-1}]}', 0, __class__)
        if jid(here) == self.channel_id:
            log_report(here.to_view(True))
            disengage(self)
