                visit(self, [target])

class join_channel(find_channel, Walker):

    @on_entry
    @set_trigger(lambda: Channel)
    def act(self, here: Channel) -> None:
        ttg_prefetch_observe(self, '{"version":2,"sql_templates":{"version":1,"sites":[],"batch":{},"linear":{},"native":{}},"walker_name":"join_channel","entries":{"act":0},"handlers":{"Channel":["act"]},"dispatch":{},"candidates":[],"points":[],"events":[{"id":0,"kind":"entry","ability":"act","line":527,"column":5,"expression":"","writes":"","reads":[],"targets":[],"hop_chain":[],"origin":"here","next_id":1,"true_id":-1,"false_id":-1,"definitions":{}},{"id":1,"kind":"barrier","ability":"act","line":528,"column":9,"expression":"","writes":"","reads":[],"targets":[],"hop_chain":[],"origin":"here","next_id":2,"true_id":-1,"false_id":-1,"definitions":{}},{"id":2,"kind":"exit","ability":"act","line":527,"column":5,"expression":"","writes":"","reads":[],"targets":[],"hop_chain":[],"origin":"here","next_id":-1,"true_id":-1,"false_id":-1,"definitions":{}}],"edges":[{"source":0,"target":1,"kind":"order","label":"","context":-1},{"source":1,"target":2,"kind":"order","label":"","context":-1}]}', 0, __class__)
        if jid(here) == self.channel_id:
            me = refs(GraphQuery(root(), hops=[QHop(dir=2, nd=Profile)]))[0]
            if not refs(GraphQuery(me, hops=[QHop(dir=2, edge=Member, only=here)], edges_only=True), lazy=True):
                connect(left=me, right=here, edge=Member())
            log_report({'success': True})
            disengage(self)
            return

class leave_channel(find_channel, Walker):

    @on_entry
    @set_trigger(lambda: Channel)
    def act(self, here: Channel) -> None:
        ttg_prefetch_observe(self, '{"version":2,"sql_templates":{"version":1,"sites":[],"batch":{},"linear":{},"native":{}},"walker_name":"leave_channel","entries":{"act":0},"handlers":{"Channel":["act"]},"dispatch":{},"candidates":[],"points":[],"events":[{"id":0,"kind":"entry","ability":"act","line":540,"column":5,"expression":"","writes":"","reads":[],"targets":[],"hop_chain":[],"origin":"here","next_id":1,"true_id":-1,"false_id":-1,"definitions":{}},{"id":1,"kind":"barrier","ability":"act","line":541,"column":9,"expression":"","writes":"","reads":[],"targets":[],"hop_chain":[],"origin":"here","next_id":2,"true_id":-1,"false_id":-1,"definitions":{}},{"id":2,"kind":"exit","ability":"act","line":540,"column":5,"expression":"","writes":"","reads":[],"targets":[],"hop_chain":[],"origin":"here","next_id":-1,"true_id":-1,"false_id":-1,"definitions":{}}],"edges":[{"source":0,"target":1,"kind":"order","label":"","context":-1},{"source":1,"target":2,"kind":"order","label":"","context":-1}]}', 0, __class__)
        if jid(here) == self.channel_id:
            me = refs(GraphQuery(root(), hops=[QHop(dir=2, nd=Profile)]))[0]
