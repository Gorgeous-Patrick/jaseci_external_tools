class get_channel_detail(find_channel, Walker):
    reports: list[ChannelView] = field(factory=lambda: [])

    @on_entry
    @set_trigger(lambda: Channel)
    def act(self, here: Channel) -> None:
        ttg_prefetch_observe(self, '{"version":2,"sql_templates":{"version":1,"sites":[],"batch":{},"linear":{},"native":{}},"walker_name":"get_channel_detail","entries":{"act":0},"handlers":{"Channel":["act"]},"dispatch":{},"candidates":[],"points":[],"events":[{"id":0,"kind":"entry","ability":"act","line":556,"column":5,"expression":"","writes":"","reads":[],"targets":[],"hop_chain":[],"origin":"here","next_id":1,"true_id":-1,"false_id":-1,"definitions":{}},{"id":1,"kind":"barrier","ability":"act","line":557,"column":9,"expression":"","writes":"","reads":[],"targets":[],"hop_chain":[],"origin":"here","next_id":2,"true_id":-1,"false_id":-1,"definitions":{}},{"id":2,"kind":"exit","ability":"act","line":556,"column":5,"expression":"","writes":"","reads":[],"targets":[],"hop_chain":[],"origin":"here","next_id":-1,"true_id":-1,"false_id":-1,"definitions":{}}],"edges":[{"source":0,"target":1,"kind":"order","label":"","context":-1},{"source":1,"target":2,"kind":"order","label":"","context":-1}]}', 0, __class__)
