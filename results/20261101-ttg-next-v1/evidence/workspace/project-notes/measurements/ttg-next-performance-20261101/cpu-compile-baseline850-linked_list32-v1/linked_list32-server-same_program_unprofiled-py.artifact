    def inspect(self, here: Root) -> None:
        ttg_prefetch_observe(self, '{"version":2,"walker_name":"SuiteInspect","entries":{"inspect":0},"handlers":{"Root":["inspect"]},"dispatch":{},"candidates":[],"points":[],"events":[{"id":0,"kind":"entry","ability":"inspect","line":408,"column":5,"expression":"","writes":"","reads":[],"targets":[],"hop_chain":[],"origin":"here","next_id":1,"true_id":-1,"false_id":-1,"definitions":{}},{"id":1,"kind":"barrier","ability":"inspect","line":408,"column":35,"expression":"","writes":"","reads":[],"targets":[],"hop_chain":[],"origin":"here","next_id":2,"true_id":-1,"false_id":-1,"definitions":{}},{"id":2,"kind":"exit","ability":"inspect","line":408,"column":5,"expression":"","writes":"","reads":[],"targets":[],"hop_chain":[],"origin":"here","next_id":-1,"true_id":-1,"false_id":-1,"definitions":{}}],"edges":[{"source":0,"target":1,"kind":"order","label":"","context":-1},{"source":1,"target":2,"kind":"order","label":"","context":-1}]}', 0, __class__)
        log_report(inspect_graph(self.mapping))