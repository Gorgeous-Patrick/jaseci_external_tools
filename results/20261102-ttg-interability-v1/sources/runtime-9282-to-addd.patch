diff --git a/jac/tests/runtimelib/fixtures/ttg_region_walkers.jac b/jac/tests/runtimelib/fixtures/ttg_region_walkers.jac
new file mode 100644
index 000000000..faafc60cb
--- /dev/null
+++ b/jac/tests/runtimelib/fixtures/ttg_region_walkers.jac
@@ -0,0 +1,132 @@
+"""Finite typed regions independent of benchmark names or counter cutoffs."""
+node RegionItem {
+    has value: int = 0;
+}
+
+edge RegionNext {}
+walker RegionTraverse {
+    can walk with RegionItem entry {
+        report here.value;
+        visit [->:RegionNext:->[?:RegionItem]];
+    }
+}
+
+walker RegionReduction {
+    has total: int = 0;
+
+    can walk with RegionItem entry {
+        self.total += here.value;
+        visit [->:RegionNext:->[?:RegionItem]];
+    }
+}
+
+node RegionA {}
+node RegionB {
+    has active: bool = True;
+}
+
+node RegionC {
+    has value: int = 9;
+}
+
+edge RegionAB {}
+edge RegionBC {}
+walker RegionGuard {
+    can start with RegionA entry {
+        visit [->:RegionAB:->[?:RegionB]];
+    }
+
+    can middle with RegionB entry {
+        if here.active {
+            visit [->:RegionBC:->[?:RegionC]];
+        }
+    }
+
+    can finish with RegionC entry {
+        report here.value;
+    }
+}
+
+walker RegionShared {
+    has count: int = 0;
+
+    can walk with RegionItem entry {
+        self.count += 1;
+        if self.count < 4 {
+            visit [->:RegionNext:->[?:RegionItem]];
+        }
+    }
+}
+
+walker RegionCancel {
+    can walk with RegionItem entry {
+        disengage;
+        visit [->:RegionNext:->[?:RegionItem]];
+    }
+}
+
+walker RegionWrite {
+    can walk with RegionItem entry {
+        here.value = 7;
+        visit [->:RegionNext:->[?:RegionItem]];
+    }
+}
+
+walker RegionUnknown {
+    can walk with RegionItem entry {
+        self.opaque();
+        visit [->:RegionNext:->[?:RegionItem]];
+    }
+
+    def opaque {
+        return;
+    }
+}
+
+walker RegionCounterOutput {
+    has visited: int = 0;
+
+    can walk with RegionItem entry {
+        self.visited += 1;
+        report here.value;
+        visit [->:RegionNext:->[?:RegionItem]];
+    }
+}
+
+walker RegionDivision {
+    has total: int = 1;
+
+    can walk with RegionItem entry {
+        self.total //= here.value;
+        visit [->:RegionNext:->[?:RegionItem]];
+    }
+}
+
+walker RegionAssign {
+    has sink: int = 0;
+
+    can walk with RegionItem entry {
+        self.sink = 1;
+        visit [->:RegionNext:->[?:RegionItem]];
+    }
+}
+
+node RegionFrontRoot {}
+node RegionFrontHub {}
+edge RegionFrontEdge {}
+edge RegionFrontLeft {}
+edge RegionFrontRight {}
+walker RegionFrontier {
+    can start with RegionFrontRoot entry {
+        visit [-->[?:RegionFrontHub]];
+    }
+
+    can collect with RegionFrontHub entry {
+        visit [->:RegionFrontLeft:->[?:RegionC]];
+        visit [->:RegionFrontRight:->[?:RegionC]];
+    }
+
+    can gather with RegionC entry {
+        report here.value;
+    }
+}
diff --git a/jac/tests/runtimelib/test_ttg_dependency_prefetch.jac b/jac/tests/runtimelib/test_ttg_dependency_prefetch.jac
index 3e5028474..4a715ee7f 100644
--- a/jac/tests/runtimelib/test_ttg_dependency_prefetch.jac
+++ b/jac/tests/runtimelib/test_ttg_dependency_prefetch.jac
@@ -142,6 +142,26 @@ test "dependency prefetch: multi-hop and finite cyclic paths consume terminal pa
 }
 
 test "dependency prefetch: chosen branch and edge subtypes populate and consume raw cache" {
+    import jaclang.runtime.prefetch as prefetch_module;
+    original_dispatch: any = dispatch_prefetch;
+    def complete_dispatch(
+        ctx: any,
+        prefetch_ids: list,
+        mode: str,
+        workers: int = 1,
+        append: bool = False,
+        observer: any = None
+    ) {
+        original_dispatch(
+            ctx, prefetch_ids, mode, workers, append=append, observer=observer
+        );
+        # This checks completed raw-cache promotion, not the production deadline.
+        # Preserve thread execution while synchronizing before native demand.
