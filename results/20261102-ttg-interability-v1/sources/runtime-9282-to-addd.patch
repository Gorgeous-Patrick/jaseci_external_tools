--- /dev/null
+++ b/jac/tests/runtimelib/test_ttg_regions.jac
@@ -0,0 +1,126 @@
+"""DB-free static summaries, emitted region SQL and bind contracts."""
+import json;
+import jaclang.sql as q;
+import from uuid { UUID }
+import from unittest.mock { patch }
+import from jaclang.runtime.ttg { JacTTGGenerator }
+import from jaclang.runtime.ttg_dependencies {
+    analyze_walker_dependencies,
+    compile_checkpoint_plan,
+    checkpoint_graph
+}
+import from jaclang.runtime.ttg_regions { summarize_abilities }
+import from jaclang.runtime.ttg_templates { bind_template }
+import from .fixtures.ttg_region_walkers {
+    RegionTraverse,
+    RegionReduction,
+    RegionGuard,
+    RegionShared,
+    RegionCancel,
+    RegionWrite,
+    RegionUnknown,
+    RegionCounterOutput,
+    RegionDivision
+}
+
+
+def region_spec(wlk: any) -> dict {
+    arch = JacTTGGenerator._find_walker_ast_node(wlk);
+    assert arch is not None;
+    return compile_checkpoint_plan(arch);
+}
+
+test "Static summaries separate output reductions from shared access guards" {
+    output = summarize_abilities(analyze_walker_dependencies(RegionReduction));
+    assert not output['walk']['eligible'];
+    assert not output['walk']['shared_access_reads'];
+    assert output['walk']['outputs'][0]['writes'] == 'self.total';
+    shared = summarize_abilities(analyze_walker_dependencies(RegionShared));
+    assert not shared['walk']['eligible'];
+    assert 'self.count' in shared['walk']['shared_access_reads'];
+    assert summarize_abilities(analyze_walker_dependencies(RegionCounterOutput))['walk'][
+        'eligible'
+    ];
+    for wlk in (RegionCancel, RegionWrite, RegionUnknown, RegionDivision) {
+        spec = region_spec(wlk);
+        assert not spec['interability_regions']['regions'] , str(spec);
+        assert spec['interability_regions']['summaries']['walk']['rejections'];
+    }
+}
+
+test "No-counter typed Traverse emits a recursive identity-certified SQL region" {
+    spec = region_spec(RegionTraverse);
+    regions = spec['interability_regions']['regions'];
+    assert len(regions) == 1;
+    certificate = next(iter(regions.values()));
+    assert len(certificate['rules']) == 1;
+    assert certificate['rules'][0]['next_phase'] == 0;
+    assert certificate['rules'][0]['dispatch_edge'];
+    sql = certificate['templates']['open']['sql'];
+    assert 'WITH RECURSIVE' in sql;
+    assert 'ANY(' in sql or 'ANY (' in sql;
+    assert 'array_append' in sql or ' || ' in sql;
+    assert 'COUNT(*) OVER' in sql.upper();
+}
+
+test "A B C uses finite dispatch composition with boolean predicate inside SQL" {
+    spec = region_spec(RegionGuard);
+    summary = spec['interability_regions']['summaries']['middle'];
+    assert summary['guard_fields'] == ['active'];
+    assert summary['sql_internal_dependencies'] == ['here.active'];
+    certificate = spec['interability_regions']['regions'][
+        str(spec['entries']['start'])
+    ];
+    assert [r['ability'] for r in certificate['rules']] == ['start', 'middle'];
+    assert certificate['rules'][0]['dispatch_edge']
+        == [certificate['rules'][0]['event'], spec['entries']['middle']];
+    sql = certificate['templates']['open']['sql'];
+    assert 'WITH RECURSIVE' not in sql;
+    assert 'jsonb_typeof' in sql;
+    assert '->>' in sql;
+    assert 'actor/ACL context' in certificate['external_dependencies'];
+    assert 'shared' in certificate['checkpoint_proof'];
+}
+
+test "Hydrated region binds without runtime SQL AST construction" {
+    spec = region_spec(RegionGuard);
+    graph = checkpoint_graph(json.loads(json.dumps(spec)), RegionGuard);
+    certificate = graph.interability_regions['regions'][str(spec['entries']['start'])];
+    descriptor = certificate['templates']['gated'];
+    values: dict = {
+        'origin': UUID(int=1),
+        'row_limit': 21,
+        'max_depth': 20,
+        'actor_uuid': UUID(int=2),
+        'actor_text': str(UUID(int=2))
+    };
+    for phase in (0, 1) {
+        values['source_module_' + str(phase)] = 'fixture';
+        values['target_module_' + str(phase)] = 'fixture';
+    }
+    values = {
+        name: value
+        for (name, value) in values.items()
+        if name in {s[0] for s in descriptor['slots']}
+    };
+    with patch.object(q, 'table', side_effect=AssertionError('runtime AST')), patch.object(
+        q, 'compile_sql', side_effect=AssertionError('runtime render')
+    ) {
+        first = bind_template(descriptor, values);
+        second = bind_template(descriptor, values);
+        assert first.sql == second.sql == descriptor['sql'];
+    }
+}
+
+test "JSON kind validates nullable JSON and rejects non-JSON operands" {
+    source = q.table('x', [q.field('props', q.json_type())]);
+    # A missing SQL value and JSON null retain distinct kinds in native SQL tests.
+    invalid = False;
+    invalid_argument: any = q.text('wrong');
+    try {
+        q.json_kind(invalid_argument);
+    } except q.SqlError {
+        invalid = True;
+    }
+    assert invalid;
+}
diff --git a/jac/tests/runtimelib/test_ttg_regions_native.jac b/jac/tests/runtimelib/test_ttg_regions_native.jac
new file mode 100644
index 000000000..d699f9c37
--- /dev/null
+++ b/jac/tests/runtimelib/test_ttg_regions_native.jac
@@ -0,0 +1,588 @@
+"""Persistent static regions: native execution, exact guards/cache and refusals."""
+import json;
+import os;
+import from pathlib { Path }
+import from tempfile { mkdtemp }
+import from uuid { UUID }
+import from unittest.mock { patch }
+import from jaclang.runtime.context { ExecutionContext }
+import from jaclang.runtime.runtime { JacRuntime }
+import from jaclang.runtime.ttg_dependency_prefetch { dependency_prefetch }
+import from jaclang.runtime.ttg_dependencies {
+    compile_checkpoint_plan,
+    checkpoint_graph
+}
+import from jaclang.runtime.ttg { JacTTGGenerator }
+import from jaclang.runtime.ttg_regions { resolve_interability_region }
+import from .fixtures.ttg_region_walkers {
+    RegionItem,
+    RegionNext,
+    RegionTraverse,
+    RegionReduction,
+    RegionCounterOutput,
+    RegionAssign,
+    RegionA,
+    RegionB,
+    RegionC,
+    RegionAB,
+    RegionBC,
+    RegionGuard,
+    RegionFrontRoot,
+    RegionFrontHub,
+    RegionFrontEdge,
+    RegionFrontLeft,
+    RegionFrontRight,
+    RegionFrontier
+}
+
+
+def region_project -> str {
+    parent = Path('/tmp/ttg-interability-fixtures');
+    parent.mkdir(parents=True, exist_ok=True);
+    return mkdtemp(prefix='case-', dir=str(parent));
+}
+
+
+def region_context(project: str) -> any {
+    ctx = ExecutionContext(
+        base_path_dir=project, full_target_path=str(Path(project, 'region.jac'))
+    );
+    JacRuntime.exec_ctx = ctx;
+    return ctx;
+}
+
+
+def region_chain(
+    project: str, count: int, fanout: bool = False, cycle: bool = False
+) -> list {
+    ctx = region_context(project);
+    try {
+        items = [RegionItem(value=i) for i in range(count)];
+        root ++> items[0];
+        for i in range(count - 1) {
+            items[i] +>:RegionNext:+> items[i + 1];
+        }
+        if fanout {
+            items[0] +>:RegionNext:+> items[2];
+        }
+        if cycle {
+            items[-1] +>:RegionNext:+> items[0];
+        }
+        return [n.__jac__.id for n in items];
+    } finally {
+        ctx.close();
+    }
+}
+
+
+def region_run(
+    project: str, uid: UUID, wlk: any, enabled: bool, strict_cache: bool = False
+) -> tuple {
+    ctx = region_context(project);
+    try {
+        origin = ctx.mem.get(uid).archetype;
+        calls: list = [];
+        store: any = ctx.mem.store;
+        original: any = store.rows;
+        def capture(sql: str, params: dict) -> list {
+            rows = original(sql, params);
+            calls.append({'sql': sql, 'params': params, 'rows': len(rows)});
+            return rows;
+        }
+        import jaclang.data.query_planner as planner;
+        import from contextlib { nullcontext }
+        native_reads: list = [];
+        original_pairs: any = planner._sql_pairs;
+        def pairs(mem: any, origin_ids: list, query: any, upto: int) -> any {
+            before = len(calls);
+            result = original_pairs(mem, origin_ids, query, upto);
+            native_reads.append(
+                {
+                    'origins': [str(x) for x in origin_ids],
+                    'upto': upto,
+                    'sql_calls': len(calls) - before
+                }
+            );
+            return result;
+        }
+        compiler_guard = patch.object(
+            planner, 'compile_query', side_effect=AssertionError('native SQL rebuild')
+        )
+            if strict_cache
+            else nullcontext();
+        topology_guard = patch.object(planner, '_topology_node_ids', return_value=None)
+            if strict_cache
+            else nullcontext();
+        with patch.object(store, 'rows', side_effect=capture), patch.object(
+            planner, '_sql_pairs', side_effect=pairs
+        ), compiler_guard, topology_guard {
+            with dependency_prefetch(
+                ctx, max_length=2048, mode='process', workers=1, fused_sql=enabled
+            ) as run {
+                origin spawn wlk;
+            }
+        }
+        assert not run.errors , str(run.errors);
+        summary = run.summary();
+        if strict_cache {
+            assert native_reads
+                and all(read['sql_calls'] == 0 for read in native_reads) , str(
+                native_reads
+            );
+        }
+        evidence = os.environ.get('TTG_INTERABILITY_EVIDENCE');
+        if evidence {
+            with open(evidence, 'a') as output {
+                output.write(
+                    json.dumps(
+                        {
+                            'wlk': type(wlk).__name__,
+                            'enabled': enabled,
+                            'reports': wlk.reports,
+                            'calls': calls,
+                            'native_pair_reads': native_reads,
+                            'strict_cache': strict_cache,
+                            'summary': summary
+                        },
+                        **{'default': str}
+                    )
+                        + '\n'
+                );
+            }
+        }
+        return (wlk.reports, summary, calls);
+    } finally {
+        ctx.close();
+    }
+}
+
+test "Actual no-counter native chain uses one static query and ordered empty cache" {
+    old = JacRuntime.exec_ctx;
+    try {
+        project = region_project();
+        ids = region_chain(project, 8);
+        plain = region_run(project, ids[0], RegionTraverse(), False);
+        fused = region_run(project, ids[0], RegionTraverse(), True, True);
+        assert plain[0] == list(range(8)) and fused[0] == plain[0];
+        assert fused[1]['fusion']['region_queries'] == 1 , str(fused[1]);
+        assert fused[1]['fusion']['region_cache_paths'] == 8;
+        assert fused[1]['fusion']['cache_empty_paths'] >= 1;
+        assert fused[1]['fusion']['region_origins'] == 8;
+        assert fused[1]['fusion']['payload_dispatches'] == 1;
+        counted = RegionCounterOutput();
+        observed = region_run(project, ids[0], counted, True, True);
+        assert counted.visited == 8 and observed[0] == fused[0];
+        assert observed[1]['fusion']['region_queries'] == 1;
+        # Actual native _sql_pairs calls are measured by region_run strict_cache; no SQL-spelling heuristic.
+    } finally {
+        JacRuntime.exec_ctx = old;
+    }
+}
+
+test "Finite A B C true false exact native reports and guard remains inside SQL" {
+    old = JacRuntime.exec_ctx;
+    try {
+        for active in (True, False) {
+            project = region_project();
+            ctx = region_context(project);
+            try {
+                a = RegionA();
+                b = RegionB(active=active);
+                c = RegionC(value=17);
+                root ++> a;
+                a +>:RegionAB:+> b;
+                b +>:RegionBC:+> c;
+                uid = a.__jac__.id;
+            } finally {
+                ctx.close();
+            }
+            plain = region_run(project, uid, RegionGuard(), False);
+            fused = region_run(project, uid, RegionGuard(), True, True);
+            assert plain[0] == ([17] if active else []);
+            assert fused[0] == plain[0];
+            assert fused[1]['fusion']['region_queries'] == 1 , str(fused[1]);
+            assert fused[1]['fusion']['region_cache_paths'] == (2 if active else 1);
+            selected = [
+                call
+                for call in fused[2]
+                if 'jsonb_typeof' in call['sql'] and 'origin_id' in call['sql']
+            ];
+            assert len(selected) == 1 , str(selected);
+        }
+    } finally {
+        JacRuntime.exec_ctx = old;
+    }
+}
+
+test "Fanout uses native fallback without changing duplicate FIFO visits" {
+    old = JacRuntime.exec_ctx;
+    try {
+        project = region_project();
+        ids = region_chain(project, 3, fanout=True);
+        plain = region_run(project, ids[0], RegionTraverse(), False);
+        fused = region_run(project, ids[0], RegionTraverse(), True);
+        assert fused[0] == plain[0];
+        assert fused[1]['fusion']['region_fallbacks'] >= 1;
+        assert fused[1]['fusion']['region_fallback_reasons'].get(
+            'Static region fanout requires native fallback', 0
+        )
+            >= 1;
+    } finally {
+        JacRuntime.exec_ctx = old;
+    }
+}
+
+test "Cycle and overflow refuse atomically before any native cache publication" {
+    import from types { SimpleNamespace }
+    old = JacRuntime.exec_ctx;
+    try {
+        for cycle in (False, True) {
+            project = region_project();
+            ids = region_chain(project, 4, cycle=cycle);
+            ctx = region_context(project);
+            try {
+                wlk = RegionTraverse();
+                origin = ctx.mem.get(ids[0]);
+                arch = JacTTGGenerator._find_walker_ast_node(RegionTraverse);
+                assert arch is not None;
+                spec = compile_checkpoint_plan(arch);
+                graph = checkpoint_graph(spec, RegionTraverse);
+                scope = SimpleNamespace(path=[origin], ignores=[]);
+                metrics: dict = {
+                    'queries': 0,
+                    'regions': [],
+                    'cache_paths': 0,
+                    'cache_empty_paths': 0
+                };
+                with patch(
+                    'jaclang.runtime.ttg_regions.publish_paths',
+                    side_effect=AssertionError('partial cache')
+                ) {
+                    result = resolve_interability_region(
+                        ctx.mem,
+                        graph,
+                        wlk,
+                        scope,
+                        spec['entries']['walk'],
+                        {'id': ids[0], 'node_type': RegionItem},
+                        [],
+                        None,
+                        20 if cycle else 2,
+                        metrics
+                    );
+                }
+                assert result is None;
+                assert 'cycle' in metrics['region_fallback_reason']
+                    if cycle
+                    else 'budget' in metrics['region_fallback_reason'];
+            } finally {
+                ctx.close();
+            }
+        }
+    } finally {
+        JacRuntime.exec_ctx = old;
+    }
+}
+
+
+test "Null missing and wrong Boolean storage reject statically but retain native behavior" {
+    old = JacRuntime.exec_ctx;
+    try {
+        for variant in ('null', 'missing', 'string') {
+            project = region_project();
+            ctx = region_context(project);
+            try {
+                a = RegionA();
+                b = RegionB(active=True);
+                c = RegionC(value=23);
+                root ++> a;
+                a +>:RegionAB:+> b;
+                b +>:RegionBC:+> c;
+                uid = a.__jac__.id;
+                bid = b.__jac__.id;
+            } finally {
+                ctx.close();
+            }
+            ctx = region_context(project);
+            try {
+                ctx.mem.read_barrier();
+                store: any = ctx.mem.store;
+                if variant == 'missing' {
+                    store.rows(
+                        "UPDATE anchors SET props = props #- '{archetype,active}' WHERE id=:id",
+                        {'id': str(bid)}
+                    );
+                } else {
+                    store.rows(
+                        "UPDATE anchors SET props=jsonb_set(props,'{archetype,active}',CAST(:value AS jsonb)) WHERE id=:id",
+                        {
+                            'id': str(bid),
+                            'value': 'null' if variant == 'null' else json.dumps('true')
+                        }
+                    );
+                }
+            } finally {
+                ctx.close();
+            }
+            plain = region_run(project, uid, RegionGuard(), False);
+            ctx = region_context(project);
+            try {
+                ctx.mem.read_barrier();
+                store: any = ctx.mem.store;
+                if variant == 'missing' {
+                    store.rows(
+                        "UPDATE anchors SET props = props #- '{archetype,active}' WHERE id=:id",
+                        {'id': str(bid)}
+                    );
+                } else {
+                    store.rows(
+                        "UPDATE anchors SET props=jsonb_set(props,'{archetype,active}',CAST(:value AS jsonb)) WHERE id=:id",
+                        {
+                            'id': str(bid),
+                            'value': 'null' if variant == 'null' else json.dumps('true')
+                        }
+                    );
+                }
+            } finally {
+                ctx.close();
+            }
+            fused = region_run(project, uid, RegionGuard(), True);
+            assert fused[0] == plain[0];
+            assert fused[1]['fusion']['region_fallbacks'] >= 1;
+            assert 'Malformed' in fused[1]['fusion']['region_fallback_reason'];
+        }
+    } finally {
+        JacRuntime.exec_ctx = old;
+    }
+}
+
+
+test "Output setter and applicable node exit reject before publication" {
+    import from types { SimpleNamespace }
+    old = JacRuntime.exec_ctx;
+    try {
+        project = region_project();
+        ids = region_chain(project, 3);
+        ctx = region_context(project);
+        try {
+            origin = ctx.mem.get(ids[0]);
+            for mode in ('setter', 'exit') {
+                wlk = RegionAssign() if mode == 'setter' else RegionTraverse();
+                cls: any = type(wlk);
