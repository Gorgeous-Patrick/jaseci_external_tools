# syntax=docker/dockerfile:1.7
ARG PYTHON_STANDALONE_URL=https://github.com/astral-sh/python-build-standalone/releases/download/20260814/cpython-3.14.7%2B20260814-x86_64-unknown-linux-gnu-freethreaded%2Bpgo%2Blto-full.tar.zst
ARG JASECI_COMMIT=unknown
ARG JASECI_SOURCE_LABEL=/home/patrickli/Space/jaseci
ARG ZIG_VERSION=0.16.0
ARG ZIG_TARBALL_URL=https://ziglang.org/download/0.16.0/zig-x86_64-linux-0.16.0.tar.xz

FROM debian:bookworm-slim AS python-runtime
ARG PYTHON_STANDALONE_URL

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates \
        curl \
        zstd \
    && rm -rf /var/lib/apt/lists/* \
    && curl -fL "$PYTHON_STANDALONE_URL" -o /tmp/python.tar.zst \
    && mkdir -p /opt/python \
    && tar -I zstd -xf /tmp/python.tar.zst -C /tmp \
    && mv /tmp/python/install/* /opt/python/ \
    && rm -rf /tmp/python /tmp/python.tar.zst

FROM debian:trixie-slim AS jac-builder
ARG ZIG_TARBALL_URL

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates \
        curl \
        git \
        xz-utils \
    && rm -rf /var/lib/apt/lists/* \
    && curl -fL "$ZIG_TARBALL_URL" -o /tmp/zig.tar.xz \
    && mkdir -p /opt/zig \
    && tar -xJf /tmp/zig.tar.xz -C /opt/zig --strip-components=1 \
    && ln -s /opt/zig/zig /usr/local/bin/zig \
    && zig version \
    && rm -f /tmp/zig.tar.xz

WORKDIR /src/jaseci
COPY --from=jaseci_src . /src/jaseci

WORKDIR /src/jaseci/jac
RUN --mount=type=cache,target=/root/.cache/zig \
    --mount=type=cache,target=/src/jaseci/jac/.pbs-build \
    --mount=type=cache,target=/src/jaseci/jac/.llvm-build \
    --mount=type=cache,target=/src/jaseci/jac/.bun-build \
    --mount=type=cache,target=/src/jaseci/jac/.payload-layers \
    --mount=type=cache,target=/src/jaseci/jac/.precompiled-build \
    zig build fetch-llvm \
    && \
    zig build

RUN ./zig-out/bin/jac --version

FROM debian:trixie-slim
ARG JASECI_COMMIT
ARG JASECI_SOURCE_LABEL

LABEL org.opencontainers.image.source="https://github.com/Gorgeous-Patrick/jaseci_external_tools" \
      org.opencontainers.image.title="jaseci_external_tools experiment runner" \
      org.opencontainers.image.description="Containerized Jac prefetch sweep experiments with Streamlit UI" \
      org.opencontainers.image.jaseci.revision="${JASECI_COMMIT}" \
      org.opencontainers.image.jaseci.source="${JASECI_SOURCE_LABEL}"

COPY --from=python-runtime /opt/python/ /usr/local/
COPY --from=jac-builder /src/jaseci/jac/zig-out/bin/jac /usr/local/bin/jac

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    JASECI_ENV_ROOT=/workspace \
    JASECI_SOURCE_LABEL=${JASECI_SOURCE_LABEL} \
    JASECI_COMMIT=${JASECI_COMMIT} \
    JAC_BIN=/usr/local/bin/jac \
    XDG_CACHE_HOME=/opt/jac/cache \
    JAC_CACHE_HOME=/opt/jac/state

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        bash \
        ca-certificates \
        curl \
        docker-compose \
        docker.io \
        git \
        libgcc-s1 \
        libstdc++6 \
        openssh-client \
        procps \
    && rm -rf /var/lib/apt/lists/*

# The sweep code calls `docker compose`. Debian's lightweight package set
# commonly provides `docker-compose` v1 but not the v2 CLI plugin, so make the
# command form work for local_docker mode. Remote SSH mode runs Docker on the
# remote host and does not use this shim.
RUN printf '%s\n' \
        '#!/bin/sh' \
        'if [ "$1" = "compose" ]; then' \
        '  shift' \
        '  exec docker-compose "$@"' \
        'fi' \
        'exec /usr/bin/docker "$@"' \
        > /usr/local/bin/docker \
    && chmod +x /usr/local/bin/docker

WORKDIR /workspace

COPY jaseci_external_tools/sweep_tool /workspace/jaseci_external_tools/sweep_tool
COPY jaseci_external_tools/tools /workspace/jaseci_external_tools/tools
COPY jaseci_external_tools/linked_list /workspace/jaseci_external_tools/linked_list
COPY jaseci_external_tools/littlex5 /workspace/jaseci_external_tools/littlex5
COPY jacord /workspace/jacord
COPY jdrive /workspace/jdrive
COPY jsearch /workspace/jsearch

RUN ! grep -R --line-number --include='*.jac' --include='*.toml' \
        --include='*.yaml' --include='*.yml' --include='*.sh' \
        --include='*.py' \
        'JAC_TTG_SQL_FANOUT' \
        /workspace/jaseci_external_tools/sweep_tool \
        /workspace/jaseci_external_tools/tools \
        /workspace/jaseci_external_tools/linked_list \
        /workspace/jaseci_external_tools/littlex5 \
        /workspace/jacord \
        /workspace/jdrive \
        /workspace/jsearch

RUN python -m pip install --upgrade pip setuptools wheel \
    && python -m pip install \
        -r /workspace/jaseci_external_tools/sweep_tool/requirements.txt \
        matplotlib \
        requests \
    && rm -rf /root/.cache/jac

RUN chmod 0755 /usr/local/bin/jac \
    && mkdir -p /opt/jac/cache /opt/jac/state \
    && jac --version \
    && mkdir /tmp/seed \
    && printf '[project]\nname = "seed"\nversion = "0.0.1"\nentry-point = "main.jac"\n\n[dependencies]\nsetuptools = ">=75"\n\n[serve]\nbase_route_app = "app"\n\n[scale.monitoring]\nenabled = true\n\n[scale.kubernetes]\nnamespace = "seed"\n' > /tmp/seed/jac.toml \
    && printf 'with entry {}\n' > /tmp/seed/main.jac \
    && (cd /tmp/seed && jac install) \
    && rt_lib=$(ls -d /opt/jac/cache/jac/rt/*/python/lib/python3.*) \
    && mkdir -p "$rt_lib/site-packages" \
    && cp -a /tmp/seed/.jac/venv/lib/python3.*/site-packages/. "$rt_lib/site-packages/" \
    && ls "$rt_lib/site-packages" | grep -q dotenv \
    && ls "$rt_lib/site-packages" | grep -q prometheus_client \
    && ls "$rt_lib/site-packages" | grep -q requests \
    && rm -rf /tmp/seed \
    && chmod -R a+rX /opt/jac/cache \
    && chmod 1777 /opt/jac/cache/jac /opt/jac/state

RUN python - <<'PY'
import sys
import sysconfig

assert sysconfig.get_config_var("Py_GIL_DISABLED") == 1, sys.version
if hasattr(sys, "_is_gil_enabled"):
    assert not sys._is_gil_enabled(), "free-threaded sweep Python is running with the GIL enabled"
PY

RUN printf '%s\n' \
        '#!/usr/bin/env bash' \
        'set -euo pipefail' \
        'echo "JASECI_COMMIT=${JASECI_COMMIT:-unknown}"' \
        'echo "JASECI_SOURCE_LABEL=${JASECI_SOURCE_LABEL:-unknown}"' \
        'echo "JAC_BIN=${JAC_BIN:-/usr/local/bin/jac}"' \
        '"${JAC_BIN:-/usr/local/bin/jac}" --version || true' \
        'python - <<'"'"'PY'"'"'' \
        'import sys' \
        'import sysconfig' \
        'print("sweep_python=" + sys.version.replace("\n", " "))' \
        'print("sweep_Py_GIL_DISABLED=" + str(sysconfig.get_config_var("Py_GIL_DISABLED")))' \
        'print("sweep_gil_enabled=" + str(sys._is_gil_enabled() if hasattr(sys, "_is_gil_enabled") else "unknown"))' \
        'PY' \
        > /usr/local/bin/jac-info \
    && chmod +x /usr/local/bin/jac-info

COPY jaseci_external_tools/docker/entrypoint.sh /usr/local/bin/experiment
COPY jaseci_external_tools/docker/run_all_sweeps.py /usr/local/bin/run-all-sweeps
RUN chmod +x /usr/local/bin/experiment /usr/local/bin/run-all-sweeps

WORKDIR /workspace/jaseci_external_tools/sweep_tool
EXPOSE 8501 8000
ENTRYPOINT ["experiment"]
CMD ["streamlit"]
